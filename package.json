{
  "name": "jupyterlab-run-python",
  "version": "0.1.0",
  "description": "JupyterLab extension to run Python scripts from editor and file browser.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "python"
  ],
  "license": "MIT",
  "author": "bmharris",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmharris626/jupyter-run-python"
  },
  "files": [
    "lib/**/*",
    "style/**/*",
    "schema/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "jupyterlab": {
    "extension": "lib/index.js",
    "outputDir": "jupyterlab_run_python/labextension",
    "schemaDir": "schema"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:labextension": "jupyter labextension build .",
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json",
    "prepare": "npm run clean && npm run build"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.2.0",
    "@jupyterlab/apputils": "^4.3.0",
    "@jupyterlab/coreutils": "^6.5.0",
    "@jupyterlab/filebrowser": "^4.3.0",
    "@jupyterlab/fileeditor": "^4.3.0",
    "@jupyterlab/services": "^7.3.0",
    "@jupyterlab/settingregistry": "^4.3.0",
    "@jupyterlab/terminal": "^4.3.0",
    "@jupyterlab/ui-components": "^4.5.0",
    "@lumino/widgets": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jupyterlab/builder": "^4.2.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.0"
  },
  "sideEffects": [
    "style/*.css"
  ]
}
